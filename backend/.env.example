# Library Atlas reads configuration from the process environment; this file is a
# reference and is not loaded automatically. Command-line options take priority over
# the environment, which takes priority over the defaults below. Never put secrets here.

# real (default) or test. test requires ATLAS_DATA_DIR pointing at a seeded test directory.
ATLAS_PROFILE=real
# Empty means %LOCALAPPDATA%\LibraryAtlas\profiles\default. An explicit directory must exist.
ATLAS_DATA_DIR=
ATLAS_PORT=8765
# Empty means frontend/dist of this repository.
ATLAS_STATIC_DIR=
# Extra loopback origins allowed to call the API, e.g. the Vite dev server.
ATLAS_DEV_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
